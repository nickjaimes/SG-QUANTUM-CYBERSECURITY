git push -u origin main

# Create cybersecurity release
gh release create v1.0.0 --title "SAFEWAY GUARDIAN Cyber Shield Initial Release" --notes "Complete Five Elements Cyber Defense Implementation"

# Install and test
pip install -e .
pytest tests/ -v
